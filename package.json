{
  "name": "@itisyb/baseui-svelte",
  "version": "0.1.0",
  "description": "Unstyled, accessible UI primitives for Svelte 5",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.svelte"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "svelte": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package",
    "build:site": "vite build",
    "prepare": "svelte-package",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:watch": "vitest",
    "validate": "npm run check && npm run test && npm run build && publint"
  },
  "peerDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "svelte": "^5.40.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.2.0",
    "@wooorm/starry-night": "^3.10.0",
    "hast-util-to-html": "^9.0.5",
    "jsdom": "^26.1.0",
    "marked": "^18.0.9",
    "publint": "^0.3.12",
    "svelte": "^5.56.8",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "headless",
    "unstyled",
    "accessible",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itisyb/baseui-svelte.git"
  },
  "bugs": {
    "url": "https://github.com/itisyb/baseui-svelte/issues"
  },
  "homepage": "https://baseui-svelte.vercel.app"
}
